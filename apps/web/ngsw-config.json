{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/**/*.css",
          "/**/*.js",
          "!/firebase-sdk-*.js",
          "!/upload-runtime-*.js",
          "/icons/icon.svg"
        ]
      }
    },
    {
      "name": "account",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/firebase-sdk-*.js"]
      }
    },
    {
      "name": "uploads",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/upload-runtime-*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
