/* TypeScript that runs in Node rather than in the browser: the Playwright suite, the Vitest config and scripts/. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "e2e/**/*.mts", "scripts/**/*.mts", "*.mts"]
}
