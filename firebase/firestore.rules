rules_version = '2';

// Who may read and write what in cubetrace's Firestore (docs/DATA-MODEL.md §10). A signed-in account
// reads and writes its own users/{uid} with its cubes and its diagnostics events, and the sessions it
// owns with their attempts and, since T4.0, the signaling documents of their remote cameras; nothing
// is public, and everything not matched here is denied. Tested against the emulator by
// firebase/rules.test.ts (`npm run test:rules`); deployed by .github/workflows/firebase.yml.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid}, the account's record (schema 1). The client writes only these fields, so that the
    // fields the server keeps there later (T3.2's upload quota) are out of its reach; createdMs, once
    // set, never changes. `viewer` (T3.10) is the clip viewer's choice per camera label, which the app
    // merges into the record apart from the sign-in's write: a map of at most 8 entries, each a map
    // of exactly the player's camera latitude (−90 to 90) and longitude (−180 to 180), in degrees,
    // and the mirror. The rules cannot loop over a map, so each entry is checked by its place in the
    // map's list of values, up to the eighth; a label cannot be empty, since Firestore refuses an
    // empty field name before the rules see it. The cap keeps the check within the engine's budget of
    // 1,000 expressions per request, which 16 entries exceeded in the emulator; the client checks the
    // numbers' type by comparing them, which raises an error, and so a refusal, on anything else.
    function userFields() {
      return ['schema', 'createdMs', 'displayName', 'email', 'devices', 'viewer'];
    }

    function validUser(user) {
      return user.schema == 1
        && user.createdMs is number
        && (user.displayName == null || user.displayName is string)
        && (user.email == null || user.email is string)
        && user.devices is map
        && (!('viewer' in user) || validViewer(user.viewer));
    }

    function validViewerChoice(choice) {
      return choice is map
        && choice.keys().hasOnly(['latitude', 'longitude', 'mirror'])
        && choice.latitude >= -90
        && choice.latitude <= 90
        && choice.longitude >= -180
        && choice.longitude <= 180
        && choice.mirror in ['none', 'left-right', 'up-down', 'front-back', 'all'];
    }

    // Entry k of the viewer map, when it has one.
    function viewerEntryOk(viewer, k) {
      return viewer.size() <= k || validViewerChoice(viewer.values()[k]);
    }

    function validViewer(viewer) {
      return viewer is map
        && viewer.size() <= 8
        && viewerEntryOk(viewer, 0)
        && viewerEntryOk(viewer, 1)
        && viewerEntryOk(viewer, 2)
        && viewerEntryOk(viewer, 3)
        && viewerEntryOk(viewer, 4)
        && viewerEntryOk(viewer, 5)
        && viewerEntryOk(viewer, 6)
        && viewerEntryOk(viewer, 7);
    }

    // users/{uid}.quota (T3.2): the account's upload quota of the day, {day, bytes, files}, which only
    // the functions write (signUpload, through the Admin SDK, past these rules). The account reads it
    // with its record; it never creates, changes or removes it, and cannot delete a record that holds
    // it, which would start the day's count again. (The field list above keeps it out already; this
    // says so, and holds should that list ever grow.)
    function serverFields() {
      return ['quota'];
    }

    function createsNoServerField() {
      return !request.resource.data.keys().hasAny(serverFields());
    }

    function keepsServerFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFields());
    }

    function holdsServerField() {
      return resource != null && resource.data.keys().hasAny(serverFields());
    }

    match /users/{uid} {
      allow read: if isOwnUid(uid);
      allow delete: if isOwnUid(uid) && !holdsServerField();
      allow create: if isOwnUid(uid)
        && createsNoServerField()
        && request.resource.data.keys().hasOnly(userFields())
        && validUser(request.resource.data);
      allow update: if isOwnUid(uid)
        && keepsServerFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userFields())
        && validUser(request.resource.data)
        && (!('createdMs' in resource.data)
          || request.resource.data.createdMs == resource.data.createdMs);
    }

    // users/{uid}/cubes/{name} (T3.4, issue #21): Settings' list of the cubes' MAC addresses, one
    // document per cube by its Bluetooth name, which only the account reads and writes. A document is
    // the entry as a device of the account writes it, whole: its own name, the MAC address normalized
    // as Settings keeps it (AB:12:CD:34:EF:56), when it last changed (the newest wins a merge) and the
    // device that wrote it. Its place is the account's, so it needs no owner.
    function cubeFields() {
      return ['schema', 'name', 'mac', 'updatedMs', 'device'];
    }

    function validCube(cube, name) {
      return cube.keys().hasAll(cubeFields())
        && cube.keys().hasOnly(cubeFields())
        && cube.schema == 1
        && cube.name == name
        && cube.mac is string
        && cube.mac.matches('[0-9A-F]{2}(:[0-9A-F]{2}){5}')
        && cube.updatedMs is number
        && cube.updatedMs >= 0
        && cube.device is string
        && cube.device.size() > 0;
    }

    match /users/{uid}/cubes/{name} {
      allow read, delete: if isOwnUid(uid);
      allow create, update: if isOwnUid(uid) && validCube(request.resource.data, name);
    }

    // sessions/{id} and their attempts carry `owner`, the uid of the account that wrote them: only
    // that account reads, updates or deletes them, a new one must name its writer, and the owner never
    // changes. An attempt is created only under a session of the same owner.
    function ownsExisting() {
      return signedIn() && resource.data.owner == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.owner == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.owner == resource.data.owner;
    }

    // The session index (T3.1, docs/DATA-MODEL.md §10): a session's document is its session.json with
    // owner, an attempt's its attempt.json without moves, with owner, device and upload. The rules
    // check the fields that the queries, the other rules and the readers rely on: the schema version,
    // the document's place (a session's id, an attempt's session and index, as its path has them:
    // `0001` is index 1), that an attempt's moves stay on the device, and the owner, which ownsNew and
    // keepsOwner hold to the writer's uid; and the shape of the fields of T3.7 where a document has
    // them (the records written before have none): a session's battery reports and its cube's
    // production date, an attempt's build, its gyro file's summary and its resyncs.
    function validApp(app) {
      return app is map
        && app.keys().hasOnly(['version', 'commit'])
        && app.keys().hasAll(['version', 'commit'])
        && app.version is string
        && app.commit is string;
    }

    function gyroFields() {
      return ['file', 'samples', 'fromHostMs', 'toHostMs', 'rateHz', 'truncatedStart'];
    }

    function validGyro(gyro) {
      return gyro is map
        && gyro.keys().hasOnly(gyroFields())
        && gyro.keys().hasAll(gyroFields())
        && gyro.file == 'gyro.json'
        && gyro.samples is int
        && gyro.samples >= 1
        && gyro.fromHostMs is number
        && gyro.toHostMs is number
        && gyro.rateHz is number
        && gyro.rateHz >= 0
        && gyro.truncatedStart is bool;
    }

    function validCubeInfo(cube) {
      return cube is map
        && (!('productDate' in cube) || cube.productDate == null || cube.productDate is string);
    }

    // The pairing of a remote camera (T4.0, docs/RTC.md): the host writes the SHA-256 of the one-time
    // token of its QR code into the session's document, with when it expires; null once it closes
    // the pairing. The token itself is never stored.
    function validPairing(pairing) {
      return pairing is map
        && pairing.keys().hasOnly(['tokenHash', 'expiresMs'])
        && pairing.keys().hasAll(['tokenHash', 'expiresMs'])
        && pairing.tokenHash is string
        && pairing.tokenHash.matches('[0-9a-f]{64}')
        && pairing.expiresMs is number;
    }

    function validSession(data, sessionId) {
      return data.schema is int
        && data.id == sessionId
        && (!('cube' in data) || validCubeInfo(data.cube))
        && (!('battery' in data) || data.battery is list)
        && (!('pairing' in data) || data.pairing == null || validPairing(data.pairing));
    }

    function validAttempt(data, sessionId, index) {
      return data.schema is int
        && data.session == sessionId
        && int(index) == data.index
        && !('moves' in data)
        && data.device is map
        && data.upload is map
        && (!('app' in data) || validApp(data.app))
        && (!('gyro' in data) || data.gyro == null || validGyro(data.gyro))
        && (!('resyncs' in data) || data.resyncs is list);
    }

    // An attempt's `upload` is written by the app with the document, all pending; from then on only the
    // upload's functions (T3.2, through the Admin SDK) change it, so the app's writes leave it alone.
    function keepsUpload() {
      return !('upload' in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /sessions/{sessionId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validSession(request.resource.data, sessionId);
      allow update: if ownsExisting() && keepsOwner()
        && validSession(request.resource.data, sessionId);

      match /attempts/{index} {
        allow read, delete: if ownsExisting();
        allow create: if ownsNew()
          && validAttempt(request.resource.data, sessionId, index)
          && getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.owner
            == request.auth.uid;
        allow update: if ownsExisting() && keepsOwner() && keepsUpload()
          && validAttempt(request.resource.data, sessionId, index);
      }

      // sessions/{id}/peers/{peerId} (T4.0, docs/RTC.md, docs/DATA-MODEL.md §10): the signaling of a
      // remote camera, the FirebaseRTC pattern. The phone (the caller) creates the document with its
      // offer and the hash of the pairing token it presents; the host (the callee) writes its answer;
      // each side adds its ICE candidates to its own subcollection and reads the other's; the host
      // deletes everything once the peer is gone. Both devices are the session's owner, signed in to
      // one account, and nobody else reads or writes any of it: the peer documents carry `owner` as
      // the attempts do, so that a query must ask for the account's own, and the candidates, which
      // carry none, are read, written and deleted only by the owner of the session they are under
      // (one `get` of the session's document per request). The shapes are checked after every
      // write: an SDP is text of at most 20,000 characters, a candidate of at most 1,000; a
      // candidate, once written, is never changed.
      function peerFields() {
        return ['schema', 'owner', 'role', 'createdMs', 'tokenHash', 'offer', 'answer', 'state'];
      }

      function validDescription(description, kind) {
        return description is map
          && description.keys().hasOnly(['type', 'sdp'])
          && description.keys().hasAll(['type', 'sdp'])
          && description.type == kind
          && description.sdp is string
          && description.sdp.size() <= 20000;
      }

      function validPeer(peer) {
        return peer.keys().hasAll(peerFields())
          && peer.keys().hasOnly(peerFields())
          && peer.schema == 1
          && peer.role == 'camera'
          && peer.createdMs is number
          && peer.tokenHash is string
          && peer.tokenHash.matches('[0-9a-f]{64}')
          && (peer.offer == null || validDescription(peer.offer, 'offer'))
          && (peer.answer == null || validDescription(peer.answer, 'answer'))
          && peer.state in ['offered', 'answered', 'closed'];
      }

      function ownsSession() {
        return signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.owner
            == request.auth.uid;
      }

      function validCandidate(candidate) {
        return candidate.keys().hasAll(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdMs'])
          && candidate.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdMs'])
          && candidate.candidate is string
          && candidate.candidate.size() <= 1000
          && (candidate.sdpMid == null
            || (candidate.sdpMid is string && candidate.sdpMid.size() <= 100))
          && (candidate.sdpMLineIndex == null
            || (candidate.sdpMLineIndex is int && candidate.sdpMLineIndex >= 0))
          && candidate.createdMs is number;
      }

      match /peers/{peerId} {
        // The phone watches its peer document until the host deletes it: a get of a document that
        // is gone (or not there yet) is the session's owner's too, so that the watcher hears the
        // deletion rather than a refusal; a list must still ask for the account's own.
        allow get: if (resource != null && ownsExisting()) || (resource == null && ownsSession());
        allow list, delete: if ownsExisting();
        allow create: if ownsNew()
          && validPeer(request.resource.data)
          && getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.owner
            == request.auth.uid;
        allow update: if ownsExisting() && keepsOwner() && validPeer(request.resource.data);

        match /{side}/{candidateId} {
          allow read, delete: if side in ['callerCandidates', 'calleeCandidates'] && ownsSession();
          allow create: if side in ['callerCandidates', 'calleeCandidates']
            && ownsSession()
            && exists(/databases/$(database)/documents/sessions/$(sessionId)/peers/$(peerId))
            && validCandidate(request.resource.data);
          allow update: if false;
        }
      }
    }

    // users/{uid}/events/{eventId} (T3.9, docs/DATA-MODEL.md §10, docs/DIAGNOSTICS.md): the account's
    // diagnostics events, one fact each about the app's own use on one of its devices, which only
    // those devices create (in batches) and only the account reads; nothing changes or deletes one,
    // since an event is what the device saw (the coordinator's round report reads them with the Admin
    // SDK, past these rules). The shape: schema 1, a time, a kind of at most 64 characters, the build
    // and the device as maps of exactly their fields, a session and an attempt only when the event
    // belongs to one, and at most 32 facts; the id is the event's time as 13 digits and 8 hex digits.
    function eventFields() {
      return ['schema', 'tsMs', 'kind', 'app', 'device', 'session', 'attempt', 'data'];
    }

    function validEventDevice(device) {
      return device is map
        && device.keys().hasOnly(['label', 'platform', 'installed'])
        && device.keys().hasAll(['label', 'platform', 'installed'])
        && device.label is string
        && device.label.size() > 0
        && device.platform is string
        && device.installed is bool;
    }

    function validEvent(event) {
      return event.keys().hasAll(['schema', 'tsMs', 'kind', 'app', 'device', 'data'])
        && event.keys().hasOnly(eventFields())
        && event.schema == 1
        && event.tsMs is number
        && event.kind is string
        && event.kind.size() <= 64
        && event.kind.matches('[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+')
        && validApp(event.app)
        && validEventDevice(event.device)
        && (!('session' in event) || (event.session is string && event.session.size() > 0))
        && (!('attempt' in event) || (event.attempt is int && event.attempt >= 1))
        && event.data is map
        && event.data.keys().size() <= 32;
    }

    match /users/{uid}/events/{eventId} {
      allow read: if isOwnUid(uid);
      allow create: if isOwnUid(uid)
        && eventId.matches('[0-9]{13}-[0-9a-f]{8}')
        && validEvent(request.resource.data);
      allow update, delete: if false;
    }
  }
}
