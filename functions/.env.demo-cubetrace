# The functions' configuration for demo-cubetrace, the offline project that the emulators run: the
# Firebase CLI reads this file after .env when the Functions emulator runs that project (npm run
# e2e:cloud), and never for a deploy to cubetrace-cacd9. The bucket is the end-to-end suite's sink, a
# server on this machine (apps/web/e2e/helpers/bucket-sink.mts, which apps/web/e2e/playwright.config.ts
# starts on this port); the functions refuse it outside the Functions emulator (src/index.ts, local.ts).
BUCKET_PROVIDER=local
LOCAL_BUCKET_URL=http://127.0.0.1:4600
