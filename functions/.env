# The functions' parameters (functions/src/params.ts), for every project: the Firebase CLI reads them
# when it deploys (and the emulator when it runs the functions) and sets them in the functions'
# environment. None of them is a secret: the R2 keys are secrets in Secret Manager
# (`firebase functions:secrets:set`), never here. A file .env.<project id> beside this one overrides
# them for that project. functions/README.md says what each one does.
BUCKET_PROVIDER=gcs
BUCKET_NAME=cubetrace-data
R2_ACCOUNT_ID=
QUOTA_BYTES_PER_DAY=2000000000
QUOTA_FILES_PER_DAY=400
MAX_FILE_BYTES=512000000
